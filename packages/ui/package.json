{
  "name": "@liquid-glass/ui",
  "version": "0.1.0",
  "description": "Token-driven, layered design library for the liquid glass effect, built on @liquid-glass/core.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./manifest": "./library.manifest.json",
    "./tokens": "./tokens/index.css",
    "./contract-tokens": "./contract-tokens.css",
    "./*": "./*"
  },
  "files": [
    "index.js",
    "library.manifest.json",
    "contract-tokens.css",
    "core",
    "tokens",
    "themes",
    "atoms",
    "components",
    "compound",
    "layouts",
    "behaviors",
    "README.md"
  ],
  "scripts": {
    "lint:css": "stylelint \"{atoms,components,compound,layouts,tokens,themes}/**/*.css\" contract-tokens.css"
  },
  "dependencies": {
    "@liquid-glass/core": "workspace:*"
  },
  "devDependencies": {
    "stylelint": "^16.10.0"
  },
  "keywords": [
    "liquid-glass",
    "design-system",
    "design-tokens",
    "ui-library",
    "glass"
  ],
  "license": "MIT"
}
