{
  "name": "liquid-glass-for-web",
  "private": true,
  "version": "0.0.0",
  "description": "Reusable, framework-agnostic liquid glass (refractive glass) effect for the web.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "lint": "eslint .",
    "reference:serve": "node source-reference/serve.mjs",
    "playground:serve": "node examples/playground/serve.mjs"
  },
  "keywords": [
    "liquid-glass",
    "glass",
    "refraction",
    "svg-filter",
    "backdrop-filter",
    "displacement-map",
    "ui-effect"
  ],
  "license": "MIT",
  "packageManager": "pnpm@9.0.0"
}
